# Starts Mochi with the graphical session. Packages replace /usr/bin with
# their install prefix.
#
#   systemctl --user enable --now mochid
#
# The session must import WAYLAND_DISPLAY (and HYPRLAND_INSTANCE_SIGNATURE on
# Hyprland) into the user manager. uwsm does this; see the README otherwise.

[Unit]
Description=Mochi desktop shell
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/mochid
ExecReload=/usr/bin/mochi reload
Restart=on-failure
RestartSec=1
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
