# Maintainer: David Gheghea

pkgname=mochi
pkgver=0.0.6
pkgrel=1
pkgdesc='A desktop shell built around a central island'
arch=('x86_64')
url='https://github.com/DavidutzDev/mochi'
license=('MIT')
# mochid refuses to start with a Quickshell outside 0.3.x; see
# QUICKSHELL_SERIES in crates/mochi-core/src/supervisor.rs.
depends=('glibc' 'libgcc' 'libpulse' 'quickshell' 'gpu-screen-recorder' 'sh' 'inter-font')
makedepends=('cargo')
# makepkg builds C with GCC's LTO by default, which leaves zstd's objects
# as GCC bitcode the Rust linker can't read.
options=('!lto')
optdepends=(
  'wl-clipboard: copy screenshots'
  'satty: edit screenshots'
  'uwsm: start apps from the launcher as units of their own'
  'xdg-desktop-portal-hyprland: pick what to share with the share module'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "MaterialSymbolsRounded.ttf::https://raw.githubusercontent.com/google/material-design-icons/bd8cb85bd4bad964fe6918f79665bb40c3a8efef/variablefont/MaterialSymbolsRounded%5BFILL%2CGRAD%2Copsz%2Cwght%5D.ttf")
sha256sums=('98b2f45369c73ab838c25aa8c8eeafc995a49b6aa937b850cdbe90ee2628c35e'
            'c2182b6337495e64cc9e2311c52522567ac277d25a842bd027f9c9e3a5cc6d86')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/mochid target/release/mochi -t "$pkgdir/usr/bin/"
  install -Dm644 systemd/mochid.service -t "$pkgdir/usr/lib/systemd/user/"
  # The fonts the shell loads: Inter from inter-font, and the icons.
  install -Dm644 "$srcdir/MaterialSymbolsRounded.ttf" -t "$pkgdir/usr/share/mochi/fonts/"
  ln -s /usr/share/fonts/inter/InterVariable.ttf "$pkgdir/usr/share/mochi/fonts/InterVariable.ttf"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  target/release/mochi completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/mochi"
  target/release/mochi completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/mochi.fish"
  target/release/mochi completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_mochi"
  # xdg-desktop-portal-hyprland runs one program, without arguments of our
  # choosing, as its screen-share picker.
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/mochi-share-picker" <<'SH'
#!/bin/sh
exec /usr/bin/mochi share-pick "$@"
SH
}
